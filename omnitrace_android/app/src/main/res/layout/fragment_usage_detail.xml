<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include
        android:id="@+id/head"
        layout="@layout/include_settings_subhead" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dash_usage_year"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.omnitrace.android.ui.dash.UsageBarsView
                android:id="@+id/chartYear"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dash_usage_custom"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFrom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnTo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/grainTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabHour"
                    style="@style/Widget.Omni.ThemeTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dash_grain_hour" />

                <include
                    layout="@layout/view_col_divider"
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabDay"
                    style="@style/Widget.Omni.ThemeTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dash_grain_day" />

                <include
                    layout="@layout/view_col_divider"
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabWeek"
                    style="@style/Widget.Omni.ThemeTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dash_grain_week" />

                <include
                    layout="@layout/view_col_divider"
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabMonth"
                    style="@style/Widget.Omni.ThemeTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dash_grain_month" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/dash_usage_pick"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fillViewport="true"
                android:scrollbars="horizontal">

                <com.omnitrace.android.ui.dash.UsageBarsView
                    android:id="@+id/chartCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="180dp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/txtPick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/fg"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
